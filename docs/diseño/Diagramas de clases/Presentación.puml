package "feature.theme" {

    class ThemesMarketplaceScreen <<Composable>>
    class ThemesMarketplaceContent <<Composable>>

    class ThemesMarketplaceViewModel {
        - _state: MutableState<ThemesMarketplaceState>
        + state: State<ThemesMarketplaceState>
        + loadMarketplace()
        + redeemTheme(themeId: String)
