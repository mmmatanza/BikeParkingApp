@startuml Presentación
skinparam style strictuml
skinparam linetype ortho
hide empty members

skinparam class {
    BackgroundColor<<State>> #FFF2CC
    BorderColor<<State>> #D6B656
}

package "feature.main" {
    class MainScreen <<Composable>>
    class MainContent <<Composable>>
    class MainViewModel {
        - _state: MutableState<MainState>
        + state: State<MainState>
        + authState: Flow<AuthState>
        + onSignoutClick()
        + clearError()
    }
    class MainState <<State>> {
        + userRole: Role?
        + error: Throwable?
    }
    MainScreen --> MainViewModel
    MainScreen --> MainContent
    MainContent ..> MainViewModel : observe/trigger
    MainViewModel o-- MainState
}

package "feature.auth" {
    class LoginScreen <<Composable>>
    class LoginContent <<Composable>>
    class LoginViewModel {
        - _state: MutableState<LoginState>
        + state: State<LoginState>
        + authState: Flow<AuthState>
        + onEmailChange(String)
        + onPasswordChange(String)
        + onLoginClick()
    }
    class LoginState <<State>> {
        + email: String
        + pass: String
        + isLoading: Boolean
        + error: String?
    }
    LoginScreen --> LoginViewModel
    LoginScreen --> LoginContent
    LoginContent ..> LoginViewModel : observe/trigger
    LoginViewModel o-- LoginState

    class RegisterScreen <<Composable>>
    class RegisterContent <<Composable>>
    class RegisterViewModel {
        - _state: MutableState<RegisterState>
        + state: State<RegisterState>
        + onEmailChange(String)
        + onPasswordChange(String)
        + onNameChange(String)
        + onTaxIdChange(String)
        + onRegisterClick()
    }
    class RegisterState <<State>> {
        + email: String
        + pass: String
        + name: String
        + taxId: String
        + isLoading: Boolean
        + error: String?
    }
    RegisterScreen --> RegisterViewModel
    RegisterScreen --> RegisterContent
    RegisterContent ..> RegisterViewModel : observe/trigger
    RegisterViewModel o-- RegisterState

    class PasswordResetScreen <<Composable>>
    class PasswordResetContent <<Composable>>
    class PasswordResetViewModel {
        - _state: MutableState<PasswordResetState>
        + state: State<PasswordResetState>
        + onEmailChange(String)
        + onResetClick()
    }
    class PasswordResetState <<State>> {
        + email: String
        + isLoading: Boolean
        + error: String?
        + success: Boolean
    }
    PasswordResetScreen --> PasswordResetViewModel
    PasswordResetScreen --> PasswordResetContent
    PasswordResetContent ..> PasswordResetViewModel : observe/trigger
    PasswordResetViewModel o-- PasswordResetState
}

package "feature.trips" {
    class MyTripsScreen <<Composable>>
    class MyTripsContent <<Composable>>
    class MyTripsViewModel {
        - _state: MutableState<MyTripsState>
        + state: State<MyTripsState>
        + loadReservations()
        + cancelReservation(String)
        + checkInReservation(String)
        + checkOutReservation(String)
        + extendReservation(String, Instant, Int)
    }
    class MyTripsState <<State>> {
        + reservations: List<ReservationDetail>
        + isLoading: Boolean
        + error: Exception?
        + checkInReservationDialog: Boolean
        + checkOutReservationDialog: Boolean
        + cancelReservationDialog: Boolean
        + extendReservationDialog: Boolean
        + reservationId: String?
    }
    MyTripsScreen --> MyTripsViewModel
    MyTripsScreen --> MyTripsContent
    MyTripsContent ..> MyTripsViewModel : observe/trigger
    MyTripsViewModel o-- MyTripsState
}

